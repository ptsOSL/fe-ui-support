	<widget type="byte_monitor" version="2.0.0">
		<name>Byte Monitor</name>
		<pv_name>$(dom)-MO-$(type)-$(number):PLCSTATUS_DIFF0</pv_name>
		<x>235</x>
		<y>76</y>
		<width>20</width>
		<height>320</height>
		<numBits>16</numBits>
		<bitReverse>true</bitReverse>
		<horizontal>false</horizontal>
		<square>true</square>
		<off_color>
			<color name="Red LED: Off" red="96" green="0" blue="0"></color>
		</off_color>
		<on_color>
			<color name="Red LED: On" red="255" green="0" blue="0"></color>
		</on_color>
		<foreground_color>
			<color name="Black" red="0" green="0" blue="0"></color>
		</foreground_color>
		<actions></actions>
		<rules>
			<rule name="onColorAlarm" prop_id="on_color" out_exp="false">
				<exp bool_exp="pvSev0==3">
					<value>
						<color name="Invalid" red="255" green="255" blue="255"></color>
					</value>
				</exp>
				<pv_name>$(pv_name)</pv_name>
			</rule>
			<rule name="offColorAlarm" prop_id="off_color" out_exp="false">
				<exp bool_exp="pvSev0==3">
					<value>
						<color name="Grey 25%" red="64" green="64" blue="64"></color>
					</value>
				</exp>
				<pv_name>$(pv_name)</pv_name>
			</rule>
		</rules>
		<border_alarm_sensitive>false</border_alarm_sensitive>
	</widget>
