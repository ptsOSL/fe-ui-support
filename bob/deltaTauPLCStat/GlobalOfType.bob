<?xml version="1.0" encoding="utf-8"?>
<display version="2.0.0">
	<name>$(controller) Delta Tau PLC Status</name>
	<x>752</x>
	<y>196</y>
	<width>600</width>
	<height>300</height>
	<background_color>
		<color name="Canvas" red="200" green="200" blue="200"></color>
	</background_color>
	<actions></actions>
	<grid_step_x>8</grid_step_x>
	<grid_step_y>8</grid_step_y>
	<widget type="label" version="2.0.0">
		<name>EDM Label</name>
		<text>$(controller) Delta Tau PLC Status</text>
		<width>600</width>
		<height>32</height>
		<font>
			<font family="liberation sans" style="BOLD" size="16.0"></font>
		</font>
		<foreground_color>
			<color name="Text: FG" red="0" green="0" blue="0"></color>
		</foreground_color>
		<background_color>
			<color name="VA title" red="202" green="223" blue="159"></color>
		</background_color>
		<transparent>false</transparent>
		<horizontal_alignment>1</horizontal_alignment>
		<vertical_alignment>1</vertical_alignment>
		<wrap_words>false</wrap_words>
		<actions></actions>
		<border_color>
			<color name="Black" red="0" green="0" blue="0"></color>
		</border_color>
	</widget>
	<widget type="action_button" version="3.0.0">
		<name>EDM Exit Button</name>
		<actions>
			<action type="close_display">
				<description>Close display</description>
			</action>
		</actions>
		<text>Exit</text>
		<x>506</x>
		<y>260</y>
		<width>61</width>
		<height>25</height>
		<font>
			<font family="liberation sans" style="REGULAR" size="14.0"></font>
		</font>
		<foreground_color>
			<color name="Exit: FG" red="196" green="0" blue="196"></color>
		</foreground_color>
		<background_color>
			<color name="Controller: BG" red="205" green="205" blue="205"></color>
		</background_color>
		<tooltip>$(actions)</tooltip>
		<border_alarm_sensitive>false</border_alarm_sensitive>
	</widget>
	<widget type="rectangle" version="2.0.0">
		<name>Rectangle</name>
		<macros>
			<pv_name></pv_name>
		</macros>
		<x>5</x>
		<y>166</y>
		<width>334</width>
		<height>95</height>
		<line_width>1</line_width>
		<line_color>
			<color name="Text: FG" red="0" green="0" blue="0"></color>
		</line_color>
		<background_color>
			<color name="Grey 75%" red="192" green="192" blue="192"></color>
		</background_color>
		<actions></actions>
		<tooltip>$(pv_name)
$(pv_value)</tooltip>
	</widget>
	<widget type="label" version="2.0.0">
		<name>Label</name>
		<text>$(controller) PLC Problem</text>
		<x>6</x>
		<y>156</y>
		<width>168</width>
		<height>18</height>
		<foreground_color>
			<color name="Text: FG" red="0" green="0" blue="0"></color>
		</foreground_color>
		<background_color>
			<color name="Grey 40%" red="102" green="102" blue="102"></color>
		</background_color>
		<transparent>false</transparent>
		<horizontal_alignment>1</horizontal_alignment>
		<vertical_alignment>1</vertical_alignment>
		<auto_size>true</auto_size>
		<wrap_words>false</wrap_words>
		<actions></actions>
		<border_width>1</border_width>
		<border_color>
			<color name="Black" red="0" green="0" blue="0"></color>
		</border_color>
	</widget>
	<widget type="byte_monitor" version="2.0.0">
		<name>Byte Monitor</name>
		<pv_name>$(dom)-MO-PLCST-01:$(type)_PLC_STATUS0:DIFF</pv_name>
		<x>13</x>
		<y>197</y>
		<width>320</width>
		<height>19</height>
		<numBits>16</numBits>
		<bitReverse>true</bitReverse>
		<square>true</square>
		<off_color>
			<color name="Red LED: Off" red="96" green="0" blue="0"></color>
		</off_color>
		<on_color>
			<color name="Red LED: On" red="255" green="0" blue="0"></color>
		</on_color>
		<foreground_color>
			<color name="Black" red="0" green="0" blue="0"></color>
		</foreground_color>
		<actions></actions>
		<rules>
			<rule name="onColorAlarm" prop_id="on_color" out_exp="false">
				<exp bool_exp="pvSev0==3">
					<value>
						<color name="Invalid" red="255" green="255" blue="255"></color>
					</value>
				</exp>
				<pv_name>$(pv_name)</pv_name>
			</rule>
			<rule name="offColorAlarm" prop_id="off_color" out_exp="false">
				<exp bool_exp="pvSev0==3">
					<value>
						<color name="Grey 25%" red="64" green="64" blue="64"></color>
					</value>
				</exp>
				<pv_name>$(pv_name)</pv_name>
			</rule>
		</rules>
		<border_alarm_sensitive>false</border_alarm_sensitive>
	</widget>
	<widget type="action_button" version="2.0.0">
		<name>Rectangle</name>
		<macros>
			<pv_name></pv_name>
		</macros>
		<x>13</x>
		<y>197</y>
		<width>20</width>
		<height>19</height>
		<line_width>0</line_width>
		<line_color>
