<?xml version="1.0" encoding="utf-8"?>
<display version="2.0.0">
	<name>Eurotherm2K Detail</name>
	<background_color>
		<color name="Canvas" red="200" green="200" blue="200"></color>
	</background_color>
	<grid_step_x>5</grid_step_x>
	<grid_step_y>5</grid_step_y>
	<widget typeId="org.csstudio.opibuilder.widgets.detailpanel" version="1.0.0">
		<widget_type>Detail Panel</widget_type>
		<font>
			<opifont.name fontName="Arial" height="11" style="0">Default</opifont.name>
		</font>
		<background_color>
			<color blue="200" green="200" name="Canvas" red="200"></color>
		</background_color>
		<foreground_color>
			<color blue="0" green="0" name="Text: FG" red="0"></color>
		</foreground_color>
		<color_odd_row_back>
			<color blue="205" green="205" name="Controller: BG" red="205"></color>
		</color_odd_row_back>
		<color_even_row_back>
			<color blue="200" green="200" name="Canvas" red="200"></color>
		</color_even_row_back>
		<border_alarm_sensitive>false</border_alarm_sensitive>
		<width>360</width>
		<vert_divider_pos>160</vert_divider_pos>
		<widget typeId="org.csstudio.opibuilder.widgets.groupingContainer" version="1.0.0">
			<widget_type>Grouping Container</widget_type>
			<font>
				<opifont.name fontName="Arial" height="11" style="0">Default</opifont.name>
			</font>
			<background_color>
				<color blue="200" green="200" name="Canvas" red="200"></color>
			</background_color>
			<foreground_color>
				<color blue="0" green="0" name="Text: FG" red="0"></color>
			</foreground_color>
			<border_alarm_sensitive>false</border_alarm_sensitive>
			<border_color>
				<color blue="200" green="200" name="Canvas" red="200"></color>
			</border_color>
			<border_style>0</border_style>
			<widget typeId="org.csstudio.opibuilder.widgets.linkingContainer" version="1.0.0">
				<widget_type>Linking Container</widget_type>
				<border_style>0</border_style>
				<resize_behaviour>1</resize_behaviour>
				<font>
					<opifont.name fontName="Arial" height="11" style="0">Default</opifont.name>
				</font>
				<background_color>
					<color blue="200" green="200" name="Canvas" red="200"></color>
				</background_color>
				<foreground_color>
					<color blue="0" green="0" name="Text: FG" red="0"></color>
				</foreground_color>
				<border_alarm_sensitive>false</border_alarm_sensitive>
				<opi_file>eurotherm2k_embed_box.opi</opi_file>
				<name>auto(boyembed)</name>
				<macros>
					<include_parent_macros>true</include_parent_macros>
				</macros>
				<width>365</width>
				<height>84</height>
			</widget>
			<height>86</height>
		</widget>
