	<widget type="action_button" version="3.0.0">
		<name>EDM shell command</name>
		<actions>
			<action type="command">
				<description>$(P)$(M):ASYN</description>
				<command>export EPICS_DISPLAY_PATH=$(MEDMDP);medm -x -macro "P=$(P)$(M),R=:ASYN" asynRecord.adl</command>
			</action>
			<action type="command">
				<description>$(P)$(M):PMACTRIG</description>
				<command>export EPICS_DISPLAY_PATH=$(MEDMDP);medm -x -macro "P=$(P)$(M),R=:PMACTRIG" asynRecord.adl</command>
			</action>
		</actions>
