	<widget type="action_button" version="2.0.0">
		<name>EDM Message Button</name>
		<bit>-1</bit>
		<x>10</x>
		<y>180</y>
		<width>171</width>
		<height>26</height>
		<off_label>Click to Resume</off_label>
		<off_color>
			<color red="240" green="240" blue="240"></color>
		</off_color>
		<on_label>Click to Resume</on_label>
		<on_color>
			<color red="192" green="192" blue="192"></color>
		</on_color>
		<show_led>false</show_led>
		<font>
			<font family="liberation sans" style="BOLD" size="14.0"></font>
		</font>
		<foreground_color>
			<color name="Dark Green" red="0" green="128" blue="0"></color>
		</foreground_color>
		<background_color>
			<color red="240" green="240" blue="240"></color>
		</background_color>
		<actions execute_as_one="true">
			<action type="write_pv">
				<description>Write PV</description>
				<pv_name>$(P):HM:RESUME.PROC</pv_name>
				<value>1</value>
			</action>
		</actions>
		<rules>
			<rule name="visibleRule" prop_id="visible" out_exp="false">
				<exp bool_exp="pv0&gt;=8.0&amp;&amp; pv0&lt;9.0">
					<value>true</value>
				</exp>
				<exp bool_exp="true">
					<value>false</value>
				</exp>
				<pv_name>$(P):HM:STATUS</pv_name>
			</rule>
			<rule name="OnOffBackgroundRule" prop_id="background_color" out_exp="false">
				<exp bool_exp="widget.getValue() == 1">
					<value>
						<color name="Controller: BG" red="205" green="205" blue="205"></color>
					</value>
				</exp>
				<exp bool_exp="true">
					<value>
						<color name="Controller: BG" red="205" green="205" blue="205"></color>
					</value>
				</exp>
				<pv_name>$(P):HM:RESUME.PROC</pv_name>
			</rule>
		</rules>
		<border_alarm_sensitive>false</border_alarm_sensitive>
		<mode>1</mode>
		<confirm_message>Are you sure you want to do this?</confirm_message>
		<text>Click to Resume</text>
	</widget>
</display>