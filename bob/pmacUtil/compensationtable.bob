	<widget type="action_button" version="3.0.0">
		<name>EDM shell command</name>
		<actions>
			<action type="command">
				<description>asyn cmd</description>
				<command>export EPICS_DISPLAY_PATH=/dls_sw/prod/R3.14.8.2/support/asyn/4-10/medm; medm -x -macro "P=$(P),R=$(M):COMPTAB:ASYN" asynRecord.adl</command>
			</action>
			<action type="command">
				<description>asyn poll 1</description>
				<command>medm -x -macro "P=$(P),R=:PC:ASYNPOLL1" asynRecord.adl</command>
			</action>
			<action type="command">
				<description>asyn poll 2</description>
				<command>medm -x -macro "P=$(P),R=:PC:ASYNPOLL2" asynRecord.adl</command>
			</action>
		</actions>
		<text>ASYN</text>
		<x>585</x>
		<y>85</y>
		<width>106</width>
		<height>31</height>
		<font>
