<?xml version="1.0" encoding="utf-8"?>
<display version="2.0.0">
	<name>Deferred move - embed</name>
	<x>779</x>
	<y>820</y>
	<width>189</width>
	<height>104</height>
	<background_color>
		<color name="Canvas" red="200" green="200" blue="200"></color>
	</background_color>
	<actions></actions>
	<grid_step_x>6</grid_step_x>
	<grid_step_y>6</grid_step_y>
	<widget type="rectangle" version="2.0.0">
		<name>EDM Rectangle</name>
		<macros>
			<pv_name></pv_name>
		</macros>
		<y>5</y>
		<width>190</width>
		<height>105</height>
		<line_width>0</line_width>
		<line_color>
			<color red="0" green="128" blue="255"></color>
		</line_color>
		<background_color>
			<color name="Grey 65%" red="166" green="166" blue="166"></color>
		</background_color>
		<actions></actions>
		<tooltip>$(pv_name)
$(pv_value)</tooltip>
	</widget>
	<widget type="choice" version="2.0.0">
		<name>EDM choice  Button</name>
		<pv_name>$(P):$(Q)</pv_name>
		<x>31</x>
		<y>51</y>
		<width>95</width>
		<height>20</height>
		<font>
			<font family="liberation sans" style="BOLD" size="14.0"></font>
		</font>
		<foreground_color>
			<color name="Controller: FG" red="0" green="0" blue="196"></color>
		</foreground_color>
		<background_color>
			<color name="Grey 65%" red="166" green="166" blue="166"></color>
		</background_color>
		<selected_color>
			<color name="Grey 65%" red="166" green="166" blue="166"></color>
		</selected_color>
		<actions></actions>
		<border_alarm_sensitive>false</border_alarm_sensitive>
		<items>
			<item>Item 1</item>
			<item>Item 2</item>
		</items>
	</widget>
	<widget type="label" version="2.0.0">
		<name>EDM Label</name>
		<text>Deferred move</text>
		<x>1</x>
		<y>1</y>
		<width>93</width>
		<height>14</height>
		<font>
			<font family="liberation sans" style="REGULAR" size="12.0"></font>
		</font>
		<foreground_color>
			<color name="Text: FG" red="0" green="0" blue="0"></color>
		</foreground_color>
		<background_color>
			<color name="Grey 50%" red="128" green="128" blue="128"></color>
		</background_color>
		<transparent>false</transparent>
		<vertical_alignment>1</vertical_alignment>
		<auto_size>true</auto_size>
		<wrap_words>false</wrap_words>
		<actions></actions>
		<border_width>1</border_width>
		<border_color>
			<color name="Black" red="0" green="0" blue="0"></color>
		</border_color>
	</widget>
</display>