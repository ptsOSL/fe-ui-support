<?xml version="1.0" encoding="utf-8"?>
<display version="2.0.0">
	<name>Linac to Booster - Vacuum Control Rack</name>
	<x>212</x>
	<y>118</y>
	<width>368</width>
	<height>816</height>
	<background_color>
		<color name="Canvas" red="200" green="200" blue="200"></color>
	</background_color>
	<actions></actions>
	<grid_step_x>8</grid_step_x>
	<grid_step_y>8</grid_step_y>
	<widget type="action_button" version="2.0.0">
		<name>EDM related display</name>
		<macros>
			<pv_name></pv_name>
		</macros>
		<x>56</x>
		<y>240</y>
		<width>258</width>
		<height>82</height>
		<line_width>0</line_width>
		<line_color>
			<color red="0" green="128" blue="255"></color>
		</line_color>
		<background_color>
			<color name="Grey 75%" red="192" green="192" blue="192"></color>
		</background_color>
		<transparent>true</transparent>
		<actions>
			<action type="open_display">
				<description>Open Display</description>
				<file>../devIocStats/ioc_stats_vxworks.opi</file>
				<macros>
					<ioc>$(dom)-VA-IOC-01</ioc>
				</macros>
				<target>standalone</target>
			</action>
		</actions>
		<tooltip>$(pv_name)
$(pv_value)</tooltip>
		<text></text>
	</widget>
