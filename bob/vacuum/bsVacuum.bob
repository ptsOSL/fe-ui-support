	<widget type="action_button" version="3.0.0">
		<name>EDM shell command</name>
		<actions>
			<action type="command">
				<description>Launch databrowser</description>
				<script file="EmbeddedPy">
					<text>from org.csstudio.opibuilder.scriptUtil import ScriptUtil

command_id="org.csstudio.trends.databrowser2.newWindow"
ScriptUtil.executeEclipseCommand(command_id, ['pvnames', '$(dom)-VA-GAUGE-01:PLOG,$(dom)-VA-GAUGE-02:PLOG,$(dom)-VA-GAUGE-21:PLOG,$(dom)-VA-GAUGE-03:PLOG,$(dom)-VA-GAUGE-04:PLOG'])</text>
				</script>
				<command>$(phoebus.install)/../phoebus.sh -resource "pv://?$(dom)-VA-GAUGE-01:PLOG&amp;$(dom)-VA-GAUGE-02:PLOG&amp;$(dom)-VA-GAUGE-21:PLOG&amp;$(dom)-VA-GAUGE-03:PLOG&amp;$(dom)-VA-GAUGE-04:PLOG&amp;app=databrowser</command>
			</action>
		</actions>
		<text>Graph</text>
		<x>909</x>
		<y>440</y>
		<width>57</width>
		<height>25</height>
		<font>
			<font family="liberation sans" style="REGULAR" size="14.0"></font>
		</font>
		<foreground_color>
			<color name="Related Display: FG" red="128" green="64" blue="0"></color>
		</foreground_color>
		<background_color>
			<color name="Controller: BG" red="205" green="205" blue="205"></color>
		</background_color>
		<tooltip>$(actions)</tooltip>
		<border_alarm_sensitive>false</border_alarm_sensitive>
	</widget>
