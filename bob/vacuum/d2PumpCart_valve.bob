<?xml version="1.0" encoding="utf-8"?>
<display version="2.0.0">
	<name>SR In Vacuum Insertion Device Cell - Vacuum</name>
	<x>68</x>
	<y>125</y>
	<width>39</width>
	<height>56</height>
	<background_color>
		<color name="Canvas" red="200" green="200" blue="200"></color>
	</background_color>
	<actions></actions>
	<grid_step_x>8</grid_step_x>
	<grid_step_y>8</grid_step_y>
	<widget type="rectangle" version="2.0.0">
		<name>Rectangle</name>
		<macros>
			<pv_name></pv_name>
		</macros>
		<width>39</width>
		<height>56</height>
		<line_width>0</line_width>
		<line_color>
			<color red="0" green="128" blue="255"></color>
		</line_color>
		<background_color>
			<color name="Disconnected" red="255" green="255" blue="255"></color>
		</background_color>
		<transparent>true</transparent>
		<actions></actions>
		<tooltip>$(pv_name)
$(pv_value)</tooltip>
	</widget>
	<widget type="rectangle" version="2.0.0">
		<name>Rectangle_1</name>
		<macros>
			<pv_name></pv_name>
		</macros>
		<x>18</x>
		<y>29</y>
		<width>2</width>
		<height>18</height>
		<line_width>10</line_width>
		<line_color>
			<color name="Text: FG" red="0" green="0" blue="0"></color>
		</line_color>
		<background_color>
			<color name="Text: FG" red="0" green="0" blue="0"></color>
		</background_color>
		<actions></actions>
		<tooltip>$(pv_name)
$(pv_value)</tooltip>
	</widget>
	<widget type="action_button" version="2.0.0">
		<name>$(device)</name>
		<macros>
			<pv_name>$(name):STA</pv_name>
		</macros>
		<x>4</x>
		<width>31</width>
		<height>31</height>
		<line_width>2</line_width>
		<line_color>
			<color name="Text: FG" red="0" green="0" blue="0"></color>
		</line_color>
		<background_color>
			<color name="Disconnected" red="255" green="255" blue="255"></color>
		</background_color>
		<corner_width>5</corner_width>
		<corner_height>5</corner_height>
		<actions>
			<action type="open_display">
				<description>Open Display</description>
				<file>../dlsPLC/vacuumValve.opi</file>
				<macros>
					<device>$(name)</device>
				</macros>
				<target>standalone</target>
			</action>
		</actions>
		<rules>
			<rule name="BackgroundColourRule" prop_id="background_color" out_exp="false">
				<exp bool_exp="pv0==1">
					<value>
						<color name="Mid Green" red="0" green="196" blue="0"></color>
					</value>
				</exp>
				<exp bool_exp="pv0==2">
					<value>
						<color red="255" green="204" blue="0"></color>
					</value>
				</exp>
				<exp bool_exp="pv0==3">
					<value>
						<color red="192" green="0" blue="0"></color>
					</value>
				</exp>
				<exp bool_exp="pv0==4">
					<value>
						<color red="255" green="204" blue="0"></color>
					</value>
				</exp>
				<exp bool_exp="pv0&gt;=5">
					<value>
						<color red="240" green="240" blue="240"></color>
					</value>
				</exp>
				<exp bool_exp="pv0==0">
					<value>
						<color name="Canvas" red="200" green="200" blue="200"></color>
					</value>
				</exp>
				<pv_name>$(pv_name)</pv_name>
			</rule>
		</rules>
		<tooltip>$(pv_name)
$(pv_value)</tooltip>
		<text></text>
	</widget>
	<widget type="polygon" version="2.0.0">
		<name>$(device)</name>
		<macros>
			<pv_name>$(name):STA</pv_name>
		</macros>
		<x>1</x>
		<y>36</y>
		<width>38</width>
		<points>
			<point x="0.0" y="0.0"></point>
			<point x="18.0" y="10.0"></point>
			<point x="37.0" y="0.0"></point>
			<point x="37.0" y="19.0"></point>
			<point x="18.0" y="10.0"></point>
			<point x="0.0" y="19.0"></point>
			<point x="0.0" y="19.0"></point>
			<point x="0.0" y="19.0"></point>
			<point x="0.0" y="19.0"></point>
			<point x="0.0" y="19.0"></point>
		</points>
		<line_width>2</line_width>
		<line_color>
			<color name="Text: FG" red="0" green="0" blue="0"></color>
		</line_color>
		<background_color>
			<color name="Disconnected" red="255" green="255" blue="255"></color>
		</background_color>
		<actions>
			<action type="open_display">
				<description>Open Display</description>
				<file>../dlsPLC/vacuumValve.opi</file>
				<target>standalone</target>
			</action>
		</actions>
		<rules>
			<rule name="BackgroundColourRule" prop_id="background_color" out_exp="false">
				<exp bool_exp="pv0==1">
					<value>
						<color name="Mid Green" red="0" green="196" blue="0"></color>
					</value>
				</exp>
				<exp bool_exp="pv0==2">
					<value>
						<color red="255" green="204" blue="0"></color>
					</value>
				</exp>
				<exp bool_exp="pv0==3">
					<value>
						<color red="192" green="0" blue="0"></color>
					</value>
				</exp>
				<exp bool_exp="pv0==4">
					<value>
						<color red="255" green="204" blue="0"></color>
					</value>
				</exp>
				<exp bool_exp="pv0&gt;=5">
					<value>
						<color red="240" green="240" blue="240"></color>
					</value>
				</exp>
				<exp bool_exp="pv0==0">
					<value>
						<color name="Canvas" red="200" green="200" blue="200"></color>
					</value>
				</exp>
				<pv_name>$(pv_name)</pv_name>
			</rule>
			<rule name="BorderColourRule" prop_id="line_color" out_exp="false">
				<exp bool_exp="pv0==0">
					<value>
						<color red="192" green="0" blue="0"></color>
					</value>
				</exp>
				<exp bool_exp="pv0&gt;0">
					<value>
						<color name="Text: FG" red="0" green="0" blue="0"></color>
					</value>
				</exp>
				<pv_name>$(pv_name)</pv_name>
			</rule>
		</rules>
		<tooltip>$(pv_name)
$(pv_value)</tooltip>
	</widget>
	<widget type="label" version="2.0.0">
		<name>Label</name>
		<text>V$(V)</text>
		<x>4</x>
		<y>1</y>
		<width>30</width>
		<height>30</height>
		<foreground_color>
			<color name="Text: FG" red="0" green="0" blue="0"></color>
		</foreground_color>
		<background_color>
			<color name="Canvas" red="200" green="200" blue="200"></color>
		</background_color>
		<horizontal_alignment>1</horizontal_alignment>
		<vertical_alignment>1</vertical_alignment>
		<wrap_words>false</wrap_words>
		<actions></actions>
		<border_color>
			<color name="Black" red="0" green="0" blue="0"></color>
		</border_color>
	</widget>
</display>