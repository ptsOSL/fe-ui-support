	</widget>
	<widget type="byte_monitor" version="2.0.0">
		<name>EDM Byte_1</name>
		<pv_name>$(GCTLR):DIG0$(chan):RAWBIT</pv_name>
		<x>10</x>
		<y>28</y>
		<width>40</width>
		<height>250</height>
		<numBits>6</numBits>
		<bitReverse>true</bitReverse>
		<horizontal>false</horizontal>
		<square>true</square>
		<off_color>
			<color name="Green LED: Off" red="0" green="96" blue="0"></color>
		</off_color>
		<on_color>
			<color name="Green LED: On" red="0" green="255" blue="0"></color>
		</on_color>
		<foreground_color>
			<color red="192" green="192" blue="192"></color>
		</foreground_color>
		<actions></actions>
		<rules>
			<rule name="onColorAlarm" prop_id="on_color" out_exp="false">
				<exp bool_exp="pvSev0==3">
					<value>
						<color name="Invalid" red="255" green="255" blue="255"></color>
					</value>
				</exp>
				<exp bool_exp="pvSev0==2">
					<value>
						<color name="Major" red="255" green="0" blue="0"></color>
					</value>
				</exp>
				<exp bool_exp="pvSev0==1">
					<value>
						<color name="Minor" red="255" green="241" blue="0"></color>
					</value>
				</exp>
				<pv_name>$(GCTLR):DIG0$(chan):RAWBIT</pv_name>
			</rule>
		</rules>
		<border_alarm_sensitive>false</border_alarm_sensitive>
	</widget>
	<widget type="progressbar" version="2.0.0">
		<name>Progress Bar</name>
		<pv_name>$(GCTLR):C$(chan)_RAW</pv_name>
		<x>58</x>
		<y>337</y>
		<width>160</width>
		<height>25</height>
		<fill_color>
			<color name="Green LED: On" red="0" green="255" blue="0"></color>
		</fill_color>
		<background_color>
			<color red="200" green="200" blue="200"></color>
		</background_color>
		<actions></actions>
		<limits_from_pv>false</limits_from_pv>
