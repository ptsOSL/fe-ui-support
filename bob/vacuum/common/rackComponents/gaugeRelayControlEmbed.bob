<?xml version="1.0" encoding="utf-8"?>
<display version="2.0.0">
	<name>SR Cell - Insertion Device - Vacuum Control Racks</name>
	<x>163</x>
	<y>140</y>
	<width>151</width>
	<height>25</height>
	<background_color>
		<color name="Wid-alt/Anno-sec" red="174" green="174" blue="174"></color>
	</background_color>
	<actions></actions>
	<grid_step_x>8</grid_step_x>
	<grid_step_y>8</grid_step_y>
	<widget type="combo" version="2.0.0">
		<name>$(GCTLR):RLY$(rly)</name>
		<pv_name>$(name):SETMODE</pv_name>
		<width>73</width>
		<height>25</height>
		<font>
			<font family="liberation sans" style="REGULAR" size="14.0"></font>
		</font>
		<foreground_color>
			<color name="Controller: FG" red="0" green="0" blue="196"></color>
		</foreground_color>
		<background_color>
			<color name="Controller: BG" red="205" green="205" blue="205"></color>
		</background_color>
		<rules>
			<rule name="Rule" prop_id="label" out_exp="false">
				<exp bool_exp="1==1">
					<value>"test"</value>
				</exp>
				<pv_name>$(name):MODE</pv_name>
			</rule>
		</rules>
		<border_alarm_sensitive>false</border_alarm_sensitive>
	</widget>
	<widget type="textupdate" version="2.0.0">
		<name>$(GCTLR):RLY$(rly)</name>
		<pv_name>$(name):MODE</pv_name>
		<x>80</x>
		<y>1</y>
		<width>71</width>
		<height>23</height>
		<font>
			<font family="liberation sans" style="REGULAR" size="12.0"></font>
		</font>
		<foreground_color>
			<color name="Monitor: FG" red="96" green="255" blue="96"></color>
		</foreground_color>
		<background_color>
			<color name="Grey 25%" red="64" green="64" blue="64"></color>
		</background_color>
		<horizontal_alignment>1</horizontal_alignment>
		<vertical_alignment>1</vertical_alignment>
		<wrap_words>false</wrap_words>
		<actions></actions>
		<border_color>
			<color name="Mid Green" red="0" green="196" blue="0"></color>
		</border_color>
	</widget>
</display>