<?xml version="1.0" encoding="utf-8"?>
<display version="2.0.0">
	<name>SR Cell - Insertion Device - Vacuum Control Racks</name>
	<x>163</x>
	<y>140</y>
	<width>256</width>
	<height>33</height>
	<background_color>
		<color name="Wid-alt/Anno-sec" red="174" green="174" blue="174"></color>
	</background_color>
	<actions></actions>
	<grid_step_x>8</grid_step_x>
	<grid_step_y>8</grid_step_y>
	<widget type="rectangle" version="2.0.0">
		<name>EDM Rectangle_57</name>
		<macros>
			<pv_name></pv_name>
		</macros>
		<width>256</width>
		<height>33</height>
		<line_width>0</line_width>
		<line_color>
			<color red="0" green="128" blue="255"></color>
		</line_color>
		<background_color>
			<color name="Grey 75%" red="192" green="192" blue="192"></color>
		</background_color>
		<actions></actions>
		<tooltip>$(pv_name)
$(pv_value)</tooltip>
	</widget>
	<widget type="label" version="2.0.0">
		<name>EDM Label</name>
		<text>$(ioc)</text>
		<width>256</width>
		<height>33</height>
		<font>
			<font family="liberation sans" style="REGULAR" size="12.0"></font>
		</font>
		<foreground_color>
			<color name="Text: FG" red="0" green="0" blue="0"></color>
		</foreground_color>
		<background_color>
			<color name="Grey 75%" red="192" green="192" blue="192"></color>
		</background_color>
		<horizontal_alignment>1</horizontal_alignment>
		<vertical_alignment>1</vertical_alignment>
		<wrap_words>false</wrap_words>
		<actions></actions>
		<border_color>
			<color name="Black" red="0" green="0" blue="0"></color>
		</border_color>
	</widget>
	<widget type="ellipse" version="2.0.0">
		<name>EDM Ellipse</name>
		<macros>
			<pv_name>$(ioc):HEARTBEAT.SEVR</pv_name>
		</macros>
		<x>17</x>
		<y>8</y>
		<width>17</width>
		<height>17</height>
		<line_width>1</line_width>
		<line_color>
			<color name="Black" red="0" green="0" blue="0"></color>
		</line_color>
		<background_color>
			<color name="Mid Green" red="0" green="196" blue="0"></color>
		</background_color>
		<actions>
			<action type="open_display">
				<description>Open Display</description>
				<file>../../../devIocStats/ioc_stats_softdls.opi</file>
				<target>standalone</target>
			</action>
		</actions>
		<rules>
			<rule name="backColorAlarmRule" prop_id="background_color" out_exp="false">
				<exp bool_exp="pvSev0==3">
					<value>
						<color name="Invalid" red="255" green="255" blue="255"></color>
					</value>
				</exp>
				<exp bool_exp="pvSev0==2">
					<value>
						<color name="Major" red="255" green="0" blue="0"></color>
					</value>
				</exp>
				<exp bool_exp="pvSev0==1">
					<value>
						<color name="Minor" red="255" green="241" blue="0"></color>
					</value>
				</exp>
				<pv_name>$(pv_name)</pv_name>
			</rule>
		</rules>
		<tooltip>$(pv_name)
$(pv_value)</tooltip>
	</widget>
</display>