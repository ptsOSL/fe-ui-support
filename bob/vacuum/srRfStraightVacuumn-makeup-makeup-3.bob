		</background_color>
		<transparent>true</transparent>
		<actions></actions>
		<widget type="action_button" version="3.0.0">
			<name>EDM Exit Button</name>
			<actions>
				<action type="close_display">
					<description>Close display</description>
				</action>
			</actions>
			<text>Exit</text>
			<x>176</x>
			<width>65</width>
			<height>25</height>
			<font>
				<font family="liberation sans" style="REGULAR" size="14.0"></font>
			</font>
			<foreground_color>
				<color name="Exit: FG" red="196" green="0" blue="196"></color>
			</foreground_color>
			<background_color>
				<color name="Controller: BG" red="205" green="205" blue="205"></color>
			</background_color>
			<tooltip>$(actions)</tooltip>
			<border_alarm_sensitive>false</border_alarm_sensitive>
		</widget>
		<widget type="action_button" version="3.0.0">
			<name>EDM shell command</name>
			<actions>
				<action type="command">
					<description>Execute Command</description>
					<command>buildStripToolconfig.sh SR$(cell)S-VA-GAUGE-01:PLOG SR$(cell)S-VA-GAUGE-03:PLOG SR$(cell)S-VA-GAUGE-04:PLOG SR$(cell)S-VA-GAUGE-22:PLOG SR$(cell)S-VA-GAUGE-07:PLOG SR$(cell)S-VA-GAUGE-08:PLOG SR$(cell)S-VA-GAUGE-10:PLOG log_mbar</command>
				</action>
			</actions>
			<text>Graph</text>
			<x>104</x>
			<width>65</width>
			<height>25</height>
			<font>
				<font family="liberation sans" style="REGULAR" size="14.0"></font>
			</font>
			<foreground_color>
				<color name="Related Display: FG" red="128" green="64" blue="0"></color>
			</foreground_color>
			<background_color>
				<color name="Controller: BG" red="205" green="205" blue="205"></color>
			</background_color>
			<tooltip>$(actions)</tooltip>
			<border_alarm_sensitive>false</border_alarm_sensitive>
		</widget>
		<widget type="action_button" version="3.0.0">
			<name>EDM related display</name>
			<actions>
				<action type="open_display">
					<description>Open Display</description>
					<file>../vacuumSpace/space.bob</file>
					<macros>
						<device>SR$(cell)S-VA-SPACE-01</device>
					</macros>
					<target>standalone</target>
				</action>
			</actions>
			<text>Space</text>
			<x>32</x>
			<width>65</width>
			<height>25</height>
			<font>
				<font family="liberation sans" style="REGULAR" size="14.0"></font>
			</font>
			<foreground_color>
