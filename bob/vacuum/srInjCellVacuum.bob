command_id="org.csstudio.trends.databrowser2.newWindow"

ScriptUtil.executeEclipseCommand(command_id, ['pvnames', 'SR$(cell)S-VA-GAUGE-01:PLOG,SR$(cell)S-VA-GAUGE-02:PLOG,SR$(cell)A-VA-GAUGE-01:PLOG,SR$(cell)A-VA-GAUGE-02:PLOG,SR$(cell)A-VA-GAUGE-21:PLOG,SR$(cell)A-VA-GAUGE-03:PLOG,SR$(cell)A-VA-GAUGE-31:PLOG,SR$(cell)A-VA-GAUGE-04:PLOG'])</text>
