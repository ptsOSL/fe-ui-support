	<widget type="action_button" version="3.0.0">
		<name>EDM shell command</name>
		<actions>
			<action type="command">
				<description>Launch databrowser</description>
				<script file="EmbeddedPy">
					<text>from org.csstudio.opibuilder.scriptUtil import ScriptUtil

command_id="org.csstudio.trends.databrowser2.newWindow"
ScriptUtil.executeEclipseCommand(command_id, ['pvnames', '$(dom)-VA-GAUGE-01:PLOG,$(dom)-VA-GAUGE-02:PLOG, $(dom)-VA-GAUGE-03:PLOG,$(dom)-VA-GAUGE-04:PLOG'])</text>
				</script>
				<command>$(phoebus.install)/../phoebus.sh -resource "pv://?$(dom)-VA-GAUGE-01:PLOG&amp;$(dom)-VA-GAUGE-02:PLOG&amp; $(dom)-VA-GAUGE-03:PLOG&amp;$(dom)-VA-GAUGE-04:PLOG&amp;app=databrowser</command>
			</action>
		</actions>
		<text>Graph</text>
