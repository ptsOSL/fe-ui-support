	<widget type="group" version="3.0.0">
		<name>1</name>
		<x>247</x>
		<y>352</y>
		<width>27</width>
		<height>27</height>
		<style>3</style>
		<foreground_color>
			<color red="0" green="128" blue="255"></color>
		</foreground_color>
		<line_color>
			<color red="0" green="128" blue="255"></color>
