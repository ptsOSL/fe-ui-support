					<exp bool_exp="pv0&gt;=7.0&amp;&amp;pv0&lt;8.0">
						<expression>8</expression>
					</exp>
					<exp bool_exp="pv0&gt;=8.0&amp;&amp;pv0&lt;9.0">
						<expression>9</expression>
					</exp>
					<exp bool_exp="pv0&gt;=9.0&amp;&amp;pv0&lt;10.0">
						<expression>10</expression>
					</exp>
					<exp bool_exp="true">
						<expression>0</expression>
					</exp>
					<pv_name>$(pv_name)</pv_name>
				</rule>
			</rules>
			<tooltip>$(pv_name)
$(pv_value)</tooltip>
			<border_alarm_sensitive>false</border_alarm_sensitive>
		</widget>
		<widget type="action_button" version="3.0.0">
			<name>Action Button</name>
			<actions execute_as_one="true">
				<action type="write_pv">
					<description>Write PV</description>
					<pv_name>$(pv_name)</pv_name>
					<value>1</value>
				</action>
			</actions>
			<pv_name>$(prefix)$(cell)S-VA-RGA-01:PWRC</pv_name>
			<text>Power</text>
			<x>27</x>
			<width>50</width>
			<height>24</height>
			<foreground_color>
				<color name="Controller: FG" red="0" green="0" blue="196"></color>
