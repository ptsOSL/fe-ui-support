<?xml version="1.0" encoding="utf-8"?>
<display version="2.0.0">
	<name>SR 8m Straight Cell - Vacuum</name>
	<x>1455</x>
	<y>862</y>
	<width>90</width>
	<height>294</height>
	<background_color>
		<color name="Canvas" red="200" green="200" blue="200"></color>
	</background_color>
	<grid_step_x>4</grid_step_x>
	<grid_step_y>4</grid_step_y>
	<widget type="action_button" version="3.0.0">
		<name>EDM shell command</name>
		<actions>
			<action type="command">
				<description>Execute Command</description>
				<command>./feGui $(cell) I</command>
			</action>
		</actions>
		<text>FE$(cell)I</text>
		<x>4</x>
		<y>260</y>
		<width>61</width>
		<height>26</height>
		<font>
			<font family="liberation sans" style="REGULAR" size="14.0"></font>
		</font>
		<foreground_color>
			<color name="Related Display: FG" red="128" green="64" blue="32"></color>
		</foreground_color>
		<background_color>
			<color name="Controller: BG" red="205" green="205" blue="205"></color>
		</background_color>
		<tooltip>$(actions)</tooltip>
		<border_alarm_sensitive>false</border_alarm_sensitive>
	</widget>
</display>