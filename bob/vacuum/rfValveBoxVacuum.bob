				<exp bool_exp="pv0&gt;=12.0&amp;&amp;pv0&lt;13.0">
					<expression>13</expression>
				</exp>
				<exp bool_exp="pv0&gt;=13.0&amp;&amp;pv0&lt;14.0">
					<expression>14</expression>
				</exp>
				<exp bool_exp="pv0&gt;=14.0&amp;&amp;pv0&lt;15.0">
					<expression>15</expression>
				</exp>
				<exp bool_exp="pv0&gt;=15.0&amp;&amp;pv0&lt;16.0">
					<expression>16</expression>
				</exp>
				<exp bool_exp="true">
					<expression>0</expression>
				</exp>
				<pv_name>$(pv_name)</pv_name>
			</rule>
		</rules>
		<border_alarm_sensitive>false</border_alarm_sensitive>
	</widget>
</display>