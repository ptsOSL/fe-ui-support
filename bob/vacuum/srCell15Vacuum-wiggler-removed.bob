	<widget type="polygon" version="2.0.0">
		<name>EDM Line</name>
		<macros>
			<pv_name></pv_name>
		</macros>
		<x>856</x>
		<y>296</y>
		<width>109</width>
		<height>49</height>
		<points>
			<point x="0.0" y="48.0"></point>
			<point x="108.0" y="48.0"></point>
			<point x="108.0" y="0.0"></point>
			<point x="0.0" y="21.0"></point>
		</points>
