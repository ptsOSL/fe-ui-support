					<text>from org.csstudio.opibuilder.scriptUtil import ScriptUtil

command_id="org.csstudio.trends.databrowser2.newWindow"
ScriptUtil.executeEclipseCommand(command_id, ['pvnames', '$(dom)-VA-GAUGE-01:PLOG,$(dom)-VA-GAUGE-02:PLOG,$(dom)-VA-GAUGE-03:PLOG,$(dom)-VA-GAUGE-04:PLOG,$(dom)-VA-GAUGE-05:PLOG,$(dom)-VA-GAUGE-06:PLOG,$(dom)-VA-GAUGE-07:PLOG,$(dom)-VA-GAUGE-08:PLOG,$(dom)-VA-GAUGE-09:PLOG'])</text>
				</script>
				<command>$(phoebus.install)/../phoebus.sh -resource "pv://?$(dom)-VA-GAUGE-01:PLOG&amp;$(dom)-VA-GAUGE-02:PLOG&amp;$(dom)-VA-GAUGE-03:PLOG&amp;$(dom)-VA-GAUGE-04:PLOG&amp;$(dom)-VA-GAUGE-05:PLOG&amp;$(dom)-VA-GAUGE-06:PLOG&amp;$(dom)-VA-GAUGE-07:PLOG&amp;$(dom)-VA-GAUGE-08:PLOG&amp;$(dom)-VA-GAUGE-09:PLOG&amp;app=databrowser</command>
			</action>
		</actions>
		<text>Graph</text>
