<?xml version="1.0" encoding="utf-8"?>
<display version="2.0.0">
	<name>Diamond 2 Vacuum Pump Cart</name>
	<x>68</x>
	<y>125</y>
	<width>300</width>
	<height>200</height>
	<background_color>
		<color name="Canvas" red="200" green="200" blue="200"></color>
