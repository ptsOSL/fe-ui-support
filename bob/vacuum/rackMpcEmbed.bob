			</line_color>
			<actions></actions>
			<tooltip>$(pv_name)
$(pv_value)</tooltip>
		</widget>
		<widget type="polyline" version="2.0.0">
			<name>EDM Line</name>
			<macros>
				<pv_name></pv_name>
			</macros>
			<y>8</y>
			<width>33</width>
			<height>1</height>
			<points>
				<point x="0.0" y="0.0"></point>
				<point x="32.0" y="0.0"></point>
			</points>
			<line_width>1</line_width>
			<line_color>
				<color name="White" red="255" green="255" blue="255"></color>
