<?xml version="1.0" encoding="utf-8"?>
<display version="2.0.0">
	<name>$(name)</name>
	<width>230</width>
	<height>62</height>
	<background_color>
		<color name="Canvas" red="200" green="200" blue="200"></color>
	</background_color>
	<actions></actions>
	<grid_step_x>5</grid_step_x>
	<grid_step_y>5</grid_step_y>
	<widget type="group" version="3.0.0">
		<name>$(LABEL)</name>
		<width>230</width>
		<height>62</height>
		<widget type="embedded" version="2.0.0">
			<name>$(LABEL)_Content</name>
			<file>pmac_variable_read_led_embed.opi</file>
			<width>200</width>
			<height>32</height>
			<resize>4</resize>
			<transparent>true</transparent>
			<actions></actions>
		</widget>
	</widget>
</display>