<?xml version="1.0" encoding="utf-8"?>
<display version="2.0.0">
	<name>$(name)</name>
	<width>250</width>
	<height>20</height>
	<background_color>
		<color name="Canvas" red="200" green="200" blue="200"></color>
	</background_color>
	<actions></actions>
	<grid_step_x>5</grid_step_x>
	<grid_step_y>5</grid_step_y>
	<widget type="action_button" version="3.0.0">
		<name>Enable</name>
		<actions>
			<action type="write_pv">
				<description>Write PV</description>
				<pv_name>$(pv_name)</pv_name>
				<value>1</value>
			</action>
		</actions>
		<pv_name>$(P)$(R).PROC</pv_name>
		<text>Run</text>
		<width>101</width>
		<height>20</height>
		<foreground_color>
			<color name="Controller" red="0" green="0" blue="255"></color>
		</foreground_color>
		<background_color>
			<color name="Controller: BG" red="205" green="205" blue="205"></color>
		</background_color>
		<tooltip>Run the command
$(pv_name)
$(actions)</tooltip>
		<border_alarm_sensitive>false</border_alarm_sensitive>
	</widget>
</display>